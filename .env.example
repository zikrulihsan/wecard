VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Jumlah kartu pertama tiap deck yang bisa dimainkan tanpa akun di /coba (bawaan 4)
VITE_TRIAL_FREE_CARDS=4

# Server-side Netlify Functions (boleh memakai URL dan anon key yang sama)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Pilih salah satu penyedia AI
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Pembelian paket kredit (Midtrans Snap). Kosongkan = paket tampil "segera hadir".
# Service role key hanya untuk Functions (pesanan & webhook) — jangan pakai prefix VITE_.
SUPABASE_SERVICE_ROLE_KEY=
MIDTRANS_SERVER_KEY=
# "true" untuk transaksi sungguhan; selain itu sandbox
MIDTRANS_PRODUCTION=false
# Landing & /coba menyebut paket kredit "bisa dibeli" (ditanam saat build)
VITE_CREDITS_ON_SALE=false
